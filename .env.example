# Development memakai PostgreSQL lokal, bukan Supabase production.
# Sesuaikan username/password dengan instalasi PostgreSQL Anda.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/titipsandi_dev"
MIGRATION_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/titipsandi_dev"

# Generate masing-masing key: openssl rand -hex 32
JWT_SECRET="replace-with-64-character-random-hex"
ENCRYPTION_KEY="replace-with-64-character-random-hex"

# Opsional saat development localhost, tetapi wajib dan divalidasi di production.
WEBAUTHN_ORIGIN=""
WEBAUTHN_RP_ID=""

# Opsional dan tampil publik di halaman Informasi.
NEXT_PUBLIC_DEVELOPER_WHATSAPP=""
