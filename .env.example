# Supabase transaction pooler (port 6543) untuk runtime Vercel.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require"

# Opsional: Supabase session pooler (port 5432) untuk Prisma migrations.
# Bila tidak diisi, prisma.config.ts otomatis mengubah DATABASE_URL dari
# transaction pooler :6543 menjadi session pooler :5432.
MIGRATION_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Generate masing-masing key: openssl rand -hex 32
JWT_SECRET="replace-with-64-character-random-hex"
ENCRYPTION_KEY="replace-with-64-character-random-hex"

# Opsional dan tampil publik di halaman Informasi.
NEXT_PUBLIC_DEVELOPER_WHATSAPP=""
NEXT_PUBLIC_DEVELOPER_EMAIL=""
NEXT_PUBLIC_DEVELOPER_DONATION_URL=""
